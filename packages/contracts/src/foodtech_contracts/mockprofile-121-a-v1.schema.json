{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodtech.example/contracts/mockprofile-121-a-v1.schema.json",
  "title": "Synthetic vendor-a combi oven REST XML record",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceId",
    "deviceId",
    "batchId",
    "recordId",
    "sequenceNumber",
    "eventTime",
    "deviceStatus",
    "measurements",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceId": {
      "const": "synthetic-rest-xml"
    },
    "deviceId": {
      "const": "mockprofile-121-a-001"
    },
    "batchId": {
      "type": "string",
      "pattern": "^batch-a-[A-Za-z0-9-]+$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^rec-a-[A-Za-z0-9-]+$"
    },
    "sequenceNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "deviceStatus": {
      "enum": [
        "running",
        "stopped"
      ]
    },
    "measurements": {
      "type": "object",
      "required": [
        "temperatureCelsius",
        "speedRpm",
        "elapsedSeconds"
      ],
      "properties": {
        "temperatureCelsius": {
          "type": "number"
        },
        "speedRpm": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "errorReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object",
      "required": [
        "equipmentType",
        "climateSetpointPercent",
        "humiditySource",
        "humidityPercent",
        "fanLevel"
      ],
      "properties": {
        "equipmentType": {
          "const": "COMBI_OVEN"
        },
        "climateSetpointPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "humiditySource": {
          "enum": [
            "MEASURED",
            "CONTROLLER_ESTIMATE",
            "NOT_SUPPORTED"
          ]
        },
        "humidityPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "fanLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "humiditySource": {
                "const": "NOT_SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "humidityPercent": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "humidityPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
